// Configuración para GitHub Codespaces (y "Dev Containers" de VS Code).
// Levanta dos contenedores: la app (.NET 10) y SQL Server 2022, con datos de ejemplo.
// No hay contraseñas aquí: se generan al azar dentro del Codespace (ver los .sh).
{
  "name": "Torre de Control",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",

  // Una sola vez, al crear el Codespace: herramientas y secretos.
  "postCreateCommand": "bash .devcontainer/preparar.sh",
  // Cada vez que el Codespace arranca: levanta la app en segundo plano.
  "postStartCommand": "bash .devcontainer/iniciar.sh",

  // Puerto de la app: 3000. Configuración mínima a propósito (solo el nombre): GitHub lo detecta
  // y lo reenvía cuando la app ya escucha. Así quedó comprobado que funciona en Codespaces; el
  // 5178 anterior quedó dañado en un Codespace (GitHub guarda el estado de cada puerto y eso
  // sobrevive a las reconstrucciones), por eso se cambió de número.
  "portsAttributes": {
    "3000": {
      "label": "Torre de Control"
    }
  },

  // SQL Server necesita unos 2 GB de memoria; la máquina básica (2 núcleos, 8 GB) alcanza.
  "hostRequirements": {
    "memory": "8gb"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit"]
    },
    "codespaces": {
      "openFiles": [".devcontainer/LEEME.md"]
    }
  }
}
