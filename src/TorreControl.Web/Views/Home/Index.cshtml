@model TorreControl.Web.Models.ViewModels.InicioViewModel
@{
    ViewData["Title"] = "Inicio";
}

@* Pantalla provisional de la Fase 1: comprueba qué plantas ve cada usuario. La tabla real llega en la Fase 2. *@
<section class="tc-tarjeta">
    <h1 class="h5 mb-1">Tus plantas</h1>
    <p class="small text-body-secondary mb-3">Servicios programados para el @Model.Hoy.ToString("dd/MM/yyyy")</p>

    @if (Model.Plantas.Count == 0)
    {
        <p class="mb-0">No tienes plantas asignadas hoy. Pide a tu supervisor que te asigne un módulo.</p>
    }
    else
    {
        <table class="table table-sm mb-0 tc-tabla-simple">
            <thead>
                <tr><th>Cliente</th><th>Planta</th><th>Municipio</th><th class="text-end">Servicios</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Plantas)
                {
                    <tr>
                        <td>@p.Cliente</td>
                        <td>@p.Planta</td>
                        <td>@p.Municipio</td>
                        <td class="text-end">@p.ServiciosHoy</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
