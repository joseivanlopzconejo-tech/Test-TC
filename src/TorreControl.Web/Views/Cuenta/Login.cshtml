@model TorreControl.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="tc-tarjeta tc-login">
    <h1 class="h5 mb-3">Iniciar sesión</h1>

    <form asp-action="Login" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="tc-error-login" role="alert"></div>

        <div class="mb-3">
            <label asp-for="NumeroEmpleado" class="form-label"></label>
            <input asp-for="NumeroEmpleado" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="NumeroEmpleado" class="small text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Contrasena" class="form-label"></label>
            <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Contrasena" class="small text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Entrar</button>
    </form>
</section>
